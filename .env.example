# ==========================================
# Aurora Flutter App Environment Variables
# ==========================================
# To use these variables when running or building the app, use:
# flutter run --dart-define-from-file=.env
# flutter build apk --dart-define-from-file=.env

# Your deployed Vercel registry URL. 
# The mobile app uses this to find the PC resolver's current LAN/WAN URL.
AURORA_REGISTRY=https://your-vercel-registry.vercel.app

# (Optional) Physical phone LAN fallback if the registry fails or is missing.
# Change this to the LAN IP of the PC running `uvicorn main:app --host 0.0.0.0 --port 8000`
AURORA_FALLBACK_LAN=http://192.168.1.100:8000

# (Optional) Set to true to skip the registry lookup entirely and always use local servers.
# AURORA_LOCAL=false

# (Optional) When AURORA_LOCAL=true, the IP for the emulator's loopback or your LAN.
# 10.0.2.2 is the Android emulator's alias for the host machine.
# AURORA_API=http://10.0.2.2:8000
