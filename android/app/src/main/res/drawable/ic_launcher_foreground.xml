<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's waveform seeker, same mark as docs/icons/logo.svg: bars mirrored on
  a midline, coloured up to the playhead and dimmed after it.

  Everything sits inside the 72dp safe zone (18..90 on both axes) so no launcher
  mask can clip it. Bars are round-capped strokes — VectorDrawable has no rect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- played: emerald sweeping to mint -->
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FF00E676" android:fillColor="#00000000"
        android:pathData="M22.5,47.5 L22.5,60.5" />
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FF0BD96A" android:fillColor="#00000000"
        android:pathData="M33,41.5 L33,66.5" />
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FF1DB954" android:fillColor="#00000000"
        android:pathData="M43.5,35.5 L43.5,72.5" />
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FF3FE9C0" android:fillColor="#00000000"
        android:pathData="M54,32.5 L54,75.5" />

    <!-- unplayed -->
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.22"
        android:fillColor="#00000000"
        android:pathData="M64.5,37.5 L64.5,70.5" />
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.22"
        android:fillColor="#00000000"
        android:pathData="M75,43.5 L75,64.5" />
    <path android:strokeWidth="7" android:strokeLineCap="round"
        android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.22"
        android:fillColor="#00000000"
        android:pathData="M85.5,49.5 L85.5,58.5" />

    <!-- playhead on the midline, at the boundary -->
    <path android:fillColor="#FF0B0C10"
        android:pathData="M59.25,48.4a5.6,5.6 0 1,0 0.1,0z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M59.25,49.9a4.1,4.1 0 1,0 0.1,0z" />
</vector>
