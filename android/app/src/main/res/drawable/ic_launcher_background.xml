<?xml version="1.0" encoding="utf-8"?>
<!-- Night gradient, matching docs/icons/logo.svg. Kept nearly neutral so the
     emerald bars in the foreground carry the colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="108">
                <item android:offset="0.0" android:color="#FF16182A" />
                <item android:offset="1.0" android:color="#FF0B0C10" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- soft accent glow behind the playhead -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60" android:centerY="54" android:gradientRadius="52">
                <item android:offset="0.0" android:color="#4D1DB954" />
                <item android:offset="1.0" android:color="#001DB954" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
