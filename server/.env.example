# ==========================================
# Aurora Resolver Server Environment Variables
# ==========================================

# Required when the resolver is exposed publicly (Cloudflare / internet).
# The Android app sends this as x-api-key on every request except /health.
AURORA_SECRET_KEY=

# (Optional) The URL of your Vercel registry deployment.
# If you deployed the `vercel-registry` folder to Vercel, put its URL here.
# Example: https://aurora-registry.vercel.app
REGISTRY_URL=

# (Optional) The secret password for your Vercel registry.
# This must match the `REGISTER_SECRET` environment variable you set on Vercel.
REGISTER_SECRET=

# (Optional) If you have a base64 encoded YouTube cookies.txt file for bypassing
# bot-walls, you can pass it here. Alternatively, mount cookies.txt into the container.
YT_COOKIES_B64=

# Port advertised to the Vercel LAN registry only (NOT uvicorn inside Docker).
# The Docker image always listens on 8000 with host networking, so keep 8000.
PORT=8000

# Persistent stream cache. Use "unlimited" to keep every downloaded song.
# A finite value such as 10GB or 500MB enables least-recently-used eviction.
AURORA_CACHE_MAX_BYTES=unlimited

# Optional cache location. Default in Docker: /app/cache (see docker-compose volume).
# AURORA_CACHE_DIR=/app/cache

# Required for authenticated playlist/favorite sync.
# Use your Firebase project ID, e.g. aurora-1058f
FIREBASE_PROJECT_ID=aurora-1058f

# YouTube Data API v3 key for subscription recommendations (Google Cloud Console).
YOUTUBE_API_KEY=

# Optional location for the persistent user-data SQLite database.
# Default in Docker: /app/data (see docker-compose volume).
# AURORA_DATA_DIR=/app/data
