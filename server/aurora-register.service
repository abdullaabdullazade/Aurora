[Unit]
Description=Push Cloudflare tunnel URL to Vercel Edge Config
After=cloudflared.service network-online.target
Requires=cloudflared.service

[Service]
Type=oneshot
User=azureuser
ExecStart=/bin/bash /home/azureuser/aurora/register_url.sh
StandardOutput=append:/home/azureuser/register.log
StandardError=append:/home/azureuser/register.log

[Install]
WantedBy=multi-user.target
